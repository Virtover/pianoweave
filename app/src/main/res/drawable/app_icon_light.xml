<?xml version="1.0" encoding="utf-8"?>
<!-- The logo by day (light themes) in the app's top bar: the splash's drawing without the ribbons' fine lines. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="18" android:translateY="18" android:scaleX="0.0703125" android:scaleY="0.0703125">
        <path android:pathData="@string/piano_weave_ribbon_back">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="102.4" android:startY="0" android:endX="921.6" android:endY="0">
                    <item android:offset="0" android:color="#BE8030" />
                    <item android:offset="0.45" android:color="#DEAA54" />
                    <item android:offset="0.75" android:color="#E8BC68" />
                    <item android:offset="1" android:color="#C08636" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="@string/piano_weave_edge_back" android:strokeColor="#FFFBF4"
            android:strokeWidth="2.4" android:strokeAlpha="0.75" android:strokeLineCap="round" />
        <path android:pathData="@string/piano_weave_ribbon_mid">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="102.4" android:startY="0" android:endX="921.6" android:endY="0">
                    <item android:offset="0" android:color="#D0923C" />
                    <item android:offset="0.4" android:color="#ECBE64" />
                    <item android:offset="0.7" android:color="#F4D088" />
                    <item android:offset="1" android:color="#CC9442" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="@string/piano_weave_edge_mid" android:strokeColor="#FFFBF4"
            android:strokeWidth="2.4" android:strokeAlpha="0.75" android:strokeLineCap="round" />
        <path android:pathData="@string/piano_weave_ribbon_front">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="102.4" android:startY="0" android:endX="921.6" android:endY="0">
                    <item android:offset="0" android:color="#DA9C42" />
                    <item android:offset="0.35" android:color="#F6C366" />
                    <item android:offset="0.65" android:color="#FCD89A" />
                    <item android:offset="1" android:color="#D29C48" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="@string/piano_weave_edge_front" android:strokeColor="#FFFBF4"
            android:strokeWidth="2.4" android:strokeAlpha="0.75" android:strokeLineCap="round" />
    </group>
</vector>
