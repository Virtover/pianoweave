<?xml version="1.0" encoding="utf-8"?>
<!-- The round logo by day (light themes): the same ribbons in warm golds shaded across, their ends a little deeper in warm bronze for its small size, a fine line and the bright edges; no halo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="900"
    android:viewportHeight="900">
    <group android:translateX="-62" android:translateY="-57">
        <path android:pathData="@string/piano_weave_ribbon_back" android:strokeColor="#9A6A26" android:strokeWidth="6" android:strokeLineJoin="round">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="102.4" android:startY="0" android:endX="921.6" android:endY="0">
                    <item android:offset="0" android:color="#B0762A" />
                    <item android:offset="0.45" android:color="#DCA44E" />
                    <item android:offset="0.75" android:color="#E8B862" />
                    <item android:offset="1" android:color="#B47C30" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="@string/piano_weave_edge_back" android:strokeColor="#FFFBF4"
            android:strokeWidth="2.4" android:strokeAlpha="0.75" android:strokeLineCap="round" />
        <path android:pathData="@string/piano_weave_ribbon_mid" android:strokeColor="#A2702A" android:strokeWidth="6" android:strokeLineJoin="round">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="102.4" android:startY="0" android:endX="921.6" android:endY="0">
                    <item android:offset="0" android:color="#C48834" />
                    <item android:offset="0.4" android:color="#EDBC60" />
                    <item android:offset="0.7" android:color="#F6CF84" />
                    <item android:offset="1" android:color="#C08C3A" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="@string/piano_weave_edge_mid" android:strokeColor="#FFFBF4"
            android:strokeWidth="2.4" android:strokeAlpha="0.75" android:strokeLineCap="round" />
        <path android:pathData="@string/piano_weave_ribbon_front" android:strokeColor="#A06A22" android:strokeWidth="6" android:strokeLineJoin="round">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="102.4" android:startY="0" android:endX="921.6" android:endY="0">
                    <item android:offset="0" android:color="#CC943C" />
                    <item android:offset="0.35" android:color="#F8C466" />
                    <item android:offset="0.65" android:color="#FFDC9C" />
                    <item android:offset="1" android:color="#C69440" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="@string/piano_weave_edge_front" android:strokeColor="#FFFBF4"
            android:strokeWidth="2.4" android:strokeAlpha="0.75" android:strokeLineCap="round" />
    </group>
