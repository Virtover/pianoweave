<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon_vector">
    <target android:name="shine">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="-240"
                android:valueTo="1024"
                android:startOffset="100"
                android:duration="800"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="glow0">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0.0668"
                    android:valueTo="0.1449"
                    android:startOffset="150"
                    android:duration="400"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0.1449"
                    android:valueTo="0.0668"
                    android:duration="450"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="glow1">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0.0513"
                    android:valueTo="0.1048"
                    android:startOffset="150"
                    android:duration="400"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0.1048"
                    android:valueTo="0.0513"
                    android:duration="450"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="glow2">
        <aapt:attr name="android:animation">
