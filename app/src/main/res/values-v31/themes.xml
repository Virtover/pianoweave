<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PianoWeave" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>

    <!-- The light launcher alias uses this for Android 12; API 33+ also selects it with setSplashScreenTheme. -->
    <style name="Theme.PianoWeave.Light" parent="Theme.PianoWeave">
        <item name="android:windowBackground">@color/splash_background_light</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding_light</item>
    </style>
</resources>
