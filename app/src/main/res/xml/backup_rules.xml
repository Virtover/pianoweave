<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android's backup keeps with the Google account (Android 11 and older; data_extraction_rules.xml is the same
    for 12 and newer): the MIDI library and account progress (tutorials done, unlocks), nothing else. Settings, the
    theme and Night / Day among them, stay with each device, so a new install never takes another device's choices.
    The downloaded models and sounds are left out too: they come back by themselves, and are larger than backup allows.
-->
<full-backup-content>
    <include domain="file" path="midi/" />
    <include domain="sharedpref" path="account_progress.xml" />
</full-backup-content>
