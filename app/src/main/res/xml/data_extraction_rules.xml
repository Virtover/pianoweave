<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and newer. Backup to the Google account: the MIDI library and account progress only (see
    backup_rules.xml); settings stay with each device. Moving to a new phone (device transfer) takes everything, as
    setting up a replacement phone should.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="midi/" />
        <include domain="sharedpref" path="account_progress.xml" />
    </cloud-backup>
</data-extraction-rules>
